[TEMPLATE]
# Auth backend selection: "api" (Django) or "mock" (local, device-only accounts).
# Unset: "api" when EXPO_PUBLIC_API_URL is set, otherwise "mock".
# This is a public (client-embedded) value, never a secret.
EXPO_PUBLIC_AUTH_MODE=api

# Base URL of the backend API, including the /api prefix.
#   Web / iOS simulator: http://localhost:8000/api
#   Android emulator:    http://10.0.2.2:8000/api
#   Physical device:     http://<your-LAN-IP>:8000/api
#     -> also add that IP to ALLOWED_HOSTS and the matching origin to
#        CORS_ALLOWED_ORIGINS in backend/.env, and to ALLOWED_HOSTS here.
# Anything here ships to the client — no secrets.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

STRIPE_SECRET_KEY=your-secret-key
STRIPE_PUBLISHABLE_KEY=your-publishable-key