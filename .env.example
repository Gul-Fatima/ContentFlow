# Auth backend selection: "mock" (local, device-only accounts) or "api".
# Unset: mock in development, api in production builds.
# This is a public (client-embedded) value, never a secret.
EXPO_PUBLIC_AUTH_MODE=mock

# Base URL of the backend API, including the /api prefix, e.g.
#   http://localhost:8000/api   (docker compose backend)
# Leave empty in mock mode. Anything here ships to the client — no secrets.
EXPO_PUBLIC_API_URL=
