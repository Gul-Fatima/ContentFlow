# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored — never commit real secrets.

# --- Django ---------------------------------------------------------------
# Local development only. Production must use DEBUG=False and a real key.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list. Add your machine's LAN IP for a physical device.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# docker-compose sets POSTGRES_HOST=db for the backend container.
# Leave POSTGRES_HOST empty to run against local SQLite instead.
POSTGRES_DB=contentflow
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=contentflow
POSTGRES_HOST=
POSTGRES_PORT=5432
# Optional: full connection URL used only when POSTGRES_HOST is empty.
DATABASE_URL=

# --- CORS -----------------------------------------------------------------
# Comma-separated frontend origins (Expo web runs on 8081).
# A physical device needs the LAN origin too, e.g. http://192.168.1.20:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Email ----------------------------------------------------------------
# Console backend prints reset emails to the server log in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@contentflow.local
# Base URL of the Expo app; password-reset links point here.
FRONTEND_URL=http://localhost:8081

# --- Payments (Stripe) ----------------------------------------------------
# Hosted Checkout + Billing Portal only. The server never sees card data.
# Leave STRIPE_SECRET_KEY empty to run without payments: billing endpoints then
# answer 503 {"code":"PAYMENTS_NOT_CONFIGURED"} instead of crashing.
# Test-mode keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint. Local dev:
#   stripe listen --forward-to localhost:8000/api/billing/webhook
# prints a whsec_... value — paste it here.
STRIPE_WEBHOOK_SECRET=

# Price IDs of the six prices you create in the Stripe Dashboard
# (3 products x monthly/yearly). See docs/BILLING_SETUP.md.
# Yearly = monthly x 12 x 0.8 ("Save 20%").
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Public origin of this API, used to build Stripe's success/cancel redirects.
# Must be reachable from the customer's device (use your LAN IP for a phone).
PUBLIC_API_ORIGIN=http://localhost:8000
# Deep-link scheme from app.json ("scheme").
APP_SCHEME=agentai

# --- Free AI (optional, existing demo features) ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
