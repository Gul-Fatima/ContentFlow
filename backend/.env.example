# Copy this file to .env and fill in the values.
# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=*

# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty to use SQLite (simplest local dev).
# Set to a Postgres URL for production / docker-compose, e.g.:
#   postgres://agentai:agentai@db:5432/agentai
DATABASE_URL=

# --- Free AI (Google Gemini via AI Studio: https://aistudio.google.com/apikey) ---
# Leave empty and the API still works using deterministic mock generation,
# so you can build the UI without spending anything.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
